[
  { "id": "goto", "label": "Open URL", "group": "Navigate", "icon": "↗",
    "fields": [ { "name": "url", "label": "URL", "type": "text", "required": true, "placeholder": "https://example.com" } ] },
  { "id": "back", "label": "Go back", "group": "Navigate", "icon": "←", "fields": [] },
  { "id": "reload", "label": "Reload page", "group": "Navigate", "icon": "⟳", "fields": [] },

  { "id": "click", "label": "Click", "group": "Interact", "icon": "◉",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true } ] },
  { "id": "dblclick", "label": "Double-click", "group": "Interact", "icon": "◎",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true } ] },
  { "id": "fill", "label": "Fill input", "group": "Interact", "icon": "✎",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true },
                { "name": "value", "label": "Value", "type": "text", "placeholder": "text or {{variable}}" } ] },
  { "id": "type", "label": "Type slowly", "group": "Interact", "icon": "⌨",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true },
                { "name": "value", "label": "Text", "type": "text" },
                { "name": "delay", "label": "Delay per key (ms)", "type": "number", "placeholder": "50" } ] },
  { "id": "press", "label": "Press key", "group": "Interact", "icon": "⏎",
    "fields": [ { "name": "selector", "label": "Selector (optional)", "type": "selector" },
                { "name": "key", "label": "Key", "type": "text", "required": true, "placeholder": "Enter, Tab, Control+A" } ] },
  { "id": "check", "label": "Check checkbox", "group": "Interact", "icon": "☑",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true } ] },
  { "id": "uncheck", "label": "Uncheck checkbox", "group": "Interact", "icon": "☐",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true } ] },
  { "id": "select", "label": "Select option", "group": "Interact", "icon": "▾",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true },
                { "name": "value", "label": "Option value or label", "type": "text", "required": true } ] },
  { "id": "hover", "label": "Hover", "group": "Interact", "icon": "☝",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true } ] },
  { "id": "upload", "label": "Upload file", "group": "Interact", "icon": "⇪",
    "fields": [ { "name": "selector", "label": "File input selector", "type": "selector", "required": true },
                { "name": "value", "label": "File path", "type": "text", "required": true } ] },
  { "id": "scroll", "label": "Scroll", "group": "Interact", "icon": "⇕",
    "fields": [ { "name": "selector", "label": "Scroll element into view (blank = page bottom)", "type": "selector" } ] },

  { "id": "wait_for", "label": "Wait for element", "group": "Wait", "icon": "⧗",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true },
                { "name": "state", "label": "State", "type": "select", "options": ["visible", "hidden", "attached", "detached"] } ] },
  { "id": "wait_for_url", "label": "Wait for URL", "group": "Wait", "icon": "⧗",
    "fields": [ { "name": "value", "label": "URL glob or substring", "type": "text", "required": true, "placeholder": "**/dashboard" } ] },
  { "id": "wait", "label": "Pause", "group": "Wait", "icon": "⏸",
    "fields": [ { "name": "ms", "label": "Milliseconds", "type": "number", "required": true, "placeholder": "1000" } ] },

  { "id": "assert_text", "label": "Expect text", "group": "Assert", "icon": "✓",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true },
                { "name": "value", "label": "Contains text", "type": "text", "required": true } ] },
  { "id": "assert_visible", "label": "Expect visible", "group": "Assert", "icon": "✓",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true } ] },
  { "id": "assert_hidden", "label": "Expect hidden", "group": "Assert", "icon": "✓",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true } ] },
  { "id": "assert_count", "label": "Expect count", "group": "Assert", "icon": "✓",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true },
                { "name": "value", "label": "Count", "type": "number", "required": true } ] },
  { "id": "assert_value", "label": "Expect input value", "group": "Assert", "icon": "✓",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true },
                { "name": "value", "label": "Value", "type": "text", "required": true } ] },
  { "id": "assert_url", "label": "Expect URL", "group": "Assert", "icon": "✓",
    "fields": [ { "name": "value", "label": "URL contains", "type": "text", "required": true } ] },
  { "id": "assert_title", "label": "Expect title", "group": "Assert", "icon": "✓",
    "fields": [ { "name": "value", "label": "Title contains", "type": "text", "required": true } ] },

  { "id": "extract_text", "label": "Save text to variable", "group": "Data", "icon": "⤓",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true },
                { "name": "var", "label": "Variable name", "type": "text", "required": true, "placeholder": "price" },
                { "name": "all", "label": "All matches (list)", "type": "checkbox" } ] },
  { "id": "extract_attr", "label": "Save attribute to variable", "group": "Data", "icon": "⤓",
    "fields": [ { "name": "selector", "label": "Selector", "type": "selector", "required": true },
                { "name": "attr", "label": "Attribute", "type": "text", "required": true, "placeholder": "href" },
                { "name": "var", "label": "Variable name", "type": "text", "required": true } ] },
  { "id": "set_var", "label": "Set variable", "group": "Data", "icon": "≔",
    "fields": [ { "name": "var", "label": "Variable name", "type": "text", "required": true },
                { "name": "value", "label": "Value", "type": "text" } ] },
  { "id": "evaluate", "label": "Run JavaScript", "group": "Data", "icon": "ƒ",
    "fields": [ { "name": "script", "label": "JS expression (runs in page)", "type": "textarea", "required": true, "placeholder": "() => document.querySelectorAll('a').length" },
                { "name": "var", "label": "Save result to variable (optional)", "type": "text" } ] },

  { "id": "screenshot", "label": "Screenshot", "group": "Capture", "icon": "▣",
    "fields": [ { "name": "name", "label": "File name", "type": "text", "placeholder": "homepage" },
                { "name": "selector", "label": "Element only (optional)", "type": "selector" },
                { "name": "full_page", "label": "Full page", "type": "checkbox" } ] },
  { "id": "pdf", "label": "Save page as PDF", "group": "Capture", "icon": "▤",
    "fields": [ { "name": "name", "label": "File name", "type": "text", "placeholder": "page" } ] },
  { "id": "log", "label": "Log message", "group": "Capture", "icon": "✱",
    "fields": [ { "name": "value", "label": "Message", "type": "text", "required": true, "placeholder": "Price is {{price}}" } ] }
]
